{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agente-salida-v2",
  "title": "Salida del agente de priorizacion asistida",
  "description": "El agente ASESORA: explica el resultado del motor, propone una valoracion de negocio (P, I) para que el dueno la apruebe, recomienda una urgencia no vinculante y propone acciones. No calcula riesgos ni fija prioridades: la prioridad final siempre es la del motor/cruce y R = P x I solo lo calcula el motor despues de la aprobacion del dueno.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hallazgo_id", "escenario_riesgo", "valoracion_negocio", "recomendacion_urgencia",
               "datos_a_verificar", "observaciones_para_revision", "controles_sugeridos", "plan_accion",
               "mitigacion_temporal", "explicacion_dashboard", "senales", "confianza"],
  "properties": {
    "schema_version": {"const": "agente-salida-v2"},
    "hallazgo_id": {"$ref": "#/$defs/uuid"},
    "escenario_riesgo": {
      "type": "object", "additionalProperties": false,
      "required": ["amenaza", "vector_ataque", "proceso_negocio_afectado", "consecuencia_negocio", "tecnicas_attack"],
      "properties": {
        "amenaza": {"$ref": "#/$defs/texto_corto"},
        "vector_ataque": {"$ref": "#/$defs/texto_corto"},
        "proceso_negocio_afectado": {"$ref": "#/$defs/texto_corto"},
        "consecuencia_negocio": {"$ref": "#/$defs/texto_medio"},
        "tecnicas_attack": {"type": "array", "maxItems": 5, "uniqueItems": true,
                            "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}}
      }
    },
    "valoracion_negocio": {
      "description": "PROPUESTA para el dueno del activo. No entra a ningun calculo hasta que el dueno la aprueba.",
      "type": "object", "additionalProperties": false,
      "required": ["probabilidad", "impacto"],
      "properties": {
        "probabilidad": {
          "type": "object", "additionalProperties": false,
          "required": ["valor", "horizonte", "justificacion", "evidencias"],
          "properties": {
            "valor": {"type": "integer", "minimum": 1, "maximum": 3},
            "horizonte": {"const": "12m"},
            "justificacion": {"$ref": "#/$defs/texto_medio"},
            "evidencias": {"$ref": "#/$defs/citas"}
          }
        },
        "impacto": {
          "type": "object", "additionalProperties": false,
          "required": ["valor", "dimensiones", "justificacion", "evidencias"],
          "properties": {
            "valor": {"type": "integer", "minimum": 1, "maximum": 3},
            "dimensiones": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
                            "items": {"enum": ["C", "I", "A"]}},
            "justificacion": {"$ref": "#/$defs/texto_medio"},
            "evidencias": {"$ref": "#/$defs/citas"}
          }
        }
      }
    },
    "recomendacion_urgencia": {
      "description": "No vinculante. 'escalar' pide revision prioritaria; 'revisar_a_la_baja' solo es admisible con datos verificados (lo decide el guard). Nunca modifica la prioridad.",
      "type": "object", "additionalProperties": false,
      "required": ["direccion", "justificacion", "evidencias"],
      "properties": {
        "direccion": {"enum": ["escalar", "mantener", "revisar_a_la_baja"]},
        "justificacion": {"$ref": "#/$defs/texto_medio"},
        "evidencias": {"$ref": "#/$defs/citas"}
      }
    },
    "datos_a_verificar": {
      "type": "array", "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["ruta_campo", "motivo"],
                "properties": {"ruta_campo": {"type": "string", "pattern": "^([a-z_]+(\\.[a-z_]+){0,3}|evidencias\\.ev-[0-9]{2,3})$", "maxLength": 80},
                               "motivo": {"$ref": "#/$defs/texto_corto"}}}
    },
    "observaciones_para_revision": {
      "description": "Discrepancias que el agente detecta en los datos (p. ej. criticidad declarada baja). Solo generan un motivo de revision humana.",
      "type": "array", "maxItems": 5,
      "items": {"type": "object", "additionalProperties": false, "required": ["ruta_campo", "observacion", "evidencias"],
                "properties": {"ruta_campo": {"type": "string", "pattern": "^([a-z_]+(\\.[a-z_]+){0,3}|evidencias\\.ev-[0-9]{2,3})$", "maxLength": 80},
                               "observacion": {"$ref": "#/$defs/texto_medio"},
                               "evidencias": {"$ref": "#/$defs/citas"}}}
    },
    "controles_sugeridos": {
      "type": "array", "maxItems": 6,
      "items": {"type": "object", "additionalProperties": false, "required": ["tipo", "descripcion"],
                "properties": {"tipo": {"enum": ["preventivo", "detectivo", "correctivo"]},
                               "descripcion": {"$ref": "#/$defs/texto_medio"}}}
    },
    "plan_accion": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["orden", "tipo", "descripcion"],
                "properties": {"orden": {"type": "integer", "minimum": 1, "maximum": 10},
                               "tipo": {"enum": ["verificacion", "contencion", "correccion", "validacion"]},
                               "descripcion": {"type": "string", "minLength": 5, "maxLength": 600}}}
    },
    "mitigacion_temporal": {"$ref": "#/$defs/texto_medio"},
    "explicacion_dashboard": {"type": "string", "minLength": 20, "maxLength": 1200},
    "senales": {
      "type": "array", "maxItems": 10, "uniqueItems": true,
      "items": {"enum": ["requiere_validacion_dueno", "aplicabilidad_dudosa", "posible_propagacion",
                         "sin_parche_disponible", "datos_insuficientes", "exposicion_no_verificada",
                         "dependencias_no_verificadas", "inventario_no_vigente", "kev_no_verificado",
                         "posible_manipulacion_feed"]}
    },
    "confianza": {"type": "number", "minimum": 0, "maximum": 0.95}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "texto_corto": {"type": "string", "minLength": 3, "maxLength": 300},
    "texto_medio": {"type": "string", "minLength": 3, "maxLength": 800},
    "citas": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^ev-[0-9]{2,3}$"}}
  }
}
